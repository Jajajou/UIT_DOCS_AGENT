# To separate your traces from other application
LANGSMITH_PROJECT=UIT-AGENT
LANGSMITH_API_KEY=
PROJECT_ROOT=C:/Users/hoang/Downloads/project/uit_firecrawl_new

# Add API keys for connecting to LLM providers, data sources, and other integrations here
RETRIEVAL_PROVIDER=LightRAG
LIGHTRAG_URL=http://localhost:9622
LIGHTRAG_API_KEY=

# Postgres
POSTGRES_URI=postgresql+psycopg2://uit:admin@123@localhost:5433/KB_DOCS

# LLM Configuration
OPENAI_BASE_URL=https://router.huggingface.co/v1
OPENAI_API_KEY=
LLM_MODEL="Qwen/Qwen3-4B-Instruct-2507"
VLLM_SERVER_URL="https://fuisloy.tail8eef0a.ts.net/v1"

# Reranker Configuration
RERANKER_MODEL="namdp-ptit/ViRanker"
RERANKER_USE_FP16=true
RERANKER_BATCH_SIZE=32

# DeepSeek OCR
MODEL_NAME="deepseek-ai/DeepSeek-OCR"
DEEPSEEK_API_KEY="EMPTY"
TOKENIZERS_PARALLELISM=true

AGENT1_TEMPERATURE=0.1
AGENT2_TEMPERATURE=0.2
AGENT3_TEMPERATURE=0.3

# ============================================
# LightRAG Core Configuration
# ============================================
# Working Directory
RAG_DIR=./data/rag_storage
# Workspace (for data isolation between different LightRAG instances)
WORKSPACE=uit_docs_agent
# Server
HOST=0.0.0.0
PORT=9621
WEBUI_TITLE='LightRAG UIT'
WEBUI_DESCRIPTION="Simple and Fast Graph Based RAG System"
WORKERS=2
MAX_PARALLEL_INSERT=10
# Authentication
AUTH_ACCOUNTS='uit:change-me,jajajou:change-me-too'
TOKEN_SECRET=
LIGHTRAG_API_KEY=
# MAX_TOTAL_TOKENS=32000

# ============================================
# LLM Configuration
# ============================================
# LLM Model
LLM_BINDING=openai
LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
LLM_BINDING_HOST=https://router.huggingface.co/v1
OPENAI_API_KEY=
# LLM Async Settings
LLM_TIMEOUT=900
MAX_ASYNC=30
# LLM Model Name (for logging/debugging)
LLM_MODEL_NAME=Qwen/Qwen3-4B-Instruct
# LLM Cache Settings
ENABLE_LLM_CACHE=true
# OPENAI_LLM_TEMPERATURE=0.5
# OPENAI_LLM_MAX_TOKENS=100000
### Chunk size for document splitting, 500~1500 is recommended
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100
# SUMMARY_MAX_TOKENS=1200

# ============================================
# Embedding Configuration
# ============================================
# Embedding thourgh Ollama: AITeamVN/Vietnamese-Embedding (1024 dim)
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://fuisloy.tail8eef0a.ts.net/v1
EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding_v2
EMBEDDING_DIM=1024
# EMBEDDING_BINDING_API_KEY=THISISATESTKEY
# Embedding Async Settings
EMBEDDING_BATCH_NUM=10
EMBEDDING_FUNC_MAX_ASYNC=8
# OLLAMA_EMBEDDING_NUM_CTX=1024
# OLLAMA_EMBEDDING_TEMPERATURE=0.0
# OLLAMA_EMBEDDING_EMBEDDING_ONLY=1

# ============================================
# Storage Configuration
# ============================================
# Storage Backends
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_VECTOR_STORAGE=QdrantVectorDBStorage
# PostgreSQL Configuration
POSTGRES_HOST=postgres_uit
POSTGRES_PORT=5432
POSTGRES_USER=uitrag
POSTGRES_PASSWORD='change-me-postgres-password'
POSTGRES_DATABASE=lightrag
POSTGRES_MAX_CONNECTIONS=12
### Qdrant
QDRANT_URL=http://localhost:6336
QDRANT_API_KEY=

# ============================================
# Document Processing Configuration
# ============================================

# Tokenizer Settings
### Tiktoken cache directory (Store cached files in this folder for offline deployment)
TIKTOKEN_CACHE_DIR=./data/tiktoken

# Summary Settings
# FORCE_LLM_SUMMARY_ON_MERGE=3
# SUMMARY_CONTEXT_SIZE=8000
# SUMMARY_MAX_TOKENS=1024
# SUMMARY_LENGTH_RECOMMENDED_=600
SUMMARY_LANGUAGE=Vietnamese

# ============================================
# Entity Types Configuration
# ============================================

# Entity types for university student affairs domain
ENTITY_TYPES='["Organization", "Person", "Regulation", "Procedure", "Scholarship", "System", "Location", "Event", "Document", "Other"]'

# Entity Types Explanation:
# - organization: Phòng Đào tạo, Phòng CTSV, Khoa, Đại học, Ban...
# - person: Sinh viên, Giảng viên, Cán bộ, Cố vấn học tập...
# - regulation: Quy chế đào tạo, Quy định học vụ, Quy trình...
# - procedure: Thủ tục hành chính, Quy trình xét học bổng...
# - scholarship: Học bổng khuyến khích, Học bổng tài trợ...
# - system: Portal, Hệ thống quản lý đào tạo, LMS...
# - location: Phòng học, Cơ sở, Ký túc xá, Thư viện...
# - event: Lễ khai giảng, Hội thảo, Hoạt động sinh viên...
# - document: Văn bản, Thông báo, Quyết định...
# - other: Các thực thể khác không thuộc các loại trên

# ============================================
# Advanced Configuration
# ============================================

# Node Embedding Algorithm
# NODE_EMBEDDING_ALGORITHM=node2vec

# Node2Vec Parameters (JSON format)
# NODE2VEC_PARAMS='{"dimensions": 1536, "num_walks": 10, "walk_length": 40, "window_size": 2, "iterations": 3, "random_seed": 3}'

# Embedding Cache Configuration (JSON format)
# EMBEDDING_CACHE_CONFIG='{"enabled": false, "similarity_threshold": 0.95, "use_llm_check": false}'

# ============================================
# Logging Configuration
# ============================================

LIGHTRAG_LOG_LEVEL=INFO
# LOG_DIR=./LightRAG/.log

# ============================================
# External Services
# ============================================
# MinerU Configuration (for PDF parsing)
MINERU_URL=http://localhost:6969
# Reranker Configuration (optional, for better retrieval)
RERANK_BINDING=cohere
RERANK_MODEL=rerank-multilingual-v3.0
RERANK_BINDING_HOST=https://api.cohere.com/v2/rerank
RERANK_BINDING_API_KEY=
