# ============================================
# LightRAG Core Configuration
# ============================================

# Working Directory
RAG_DIR=./rag_storage

# Workspace (for data isolation between different LightRAG instances)
# WORKSPACE=default

# ============================================
# LLM Configuration
# ============================================

# LLM Model
LLM_MODEL=Qwen/Qwen3-4B-Instruct
LLM_BINDING_HOST=https://router.huggingface.co/v1
OPENAI_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM Model Name (for logging/debugging)
LLM_MODEL_NAME=Qwen/Qwen3-4B-Instruct

# LLM Async Settings
MAX_ASYNC=4
LLM_TIMEOUT=900

# LLM Cache Settings
ENABLE_LLM_CACHE=true
ENABLE_LLM_CACHE_FOR_ENTITY_EXTRACT=true

# ============================================
# Embedding Configuration
# ============================================

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BINDING_HOST=http://localhost:11434
EMBEDDING_DIM=1024

# Embedding Async Settings
EMBEDDING_BATCH_NUM=32
EMBEDDING_FUNC_MAX_ASYNC=16

# ============================================
# Storage Configuration
# ============================================

# Storage Backends
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage

# PostgreSQL Configuration (if using PG storage)
# LIGHTRAG_KV_STORAGE=PGKVStorage
# LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
# LIGHTRAG_GRAPH_STORAGE=PGGraphStorage
# LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# POSTGRES_DATABASE=lightrag_db

# Qdrant Configuration (if using Qdrant vector storage)
# LIGHTRAG_VECTOR_STORAGE=QdrantVectorDBStorage
# QDRANT_URL=http://localhost:6333

# Neo4j Configuration (if using Neo4j graph storage)
# LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# Vector DB Storage Settings
COSINE_THRESHOLD=0.2

# ============================================
# Document Processing Configuration
# ============================================

# Chunk Settings
CHUNK_TOKEN_SIZE=1200
CHUNK_OVERLAP_TOKEN_SIZE=100

### Tiktoken cache directory (Store cached files in this folder for offline deployment)
# TIKTOKEN_CACHE_DIR=./LightRAG/app/data/tiktoken

# Summary Settings
SUMMARY_CONTEXT_SIZE=10000
SUMMARY_MAX_TOKENS=500
SUMMARY_LANGUAGE=Vietnamese

# ============================================
# Entity Types Configuration
# ============================================

# Entity types for university student affairs domain
ENTITY_TYPES='["organization", "person", "regulation", "procedure", "scholarship", "system", "location", "event", "document", "other"]'

# Entity Types Explanation:
# - organization: Phòng Đào tạo, Phòng CTSV, Khoa, Đại học, Ban...
# - person: Sinh viên, Giảng viên, Cán bộ, Cố vấn học tập...
# - regulation: Quy chế đào tạo, Quy định học vụ, Quy trình...
# - procedure: Thủ tục hành chính, Quy trình xét học bổng...
# - scholarship: Học bổng khuyến khích, Học bổng tài trợ...
# - system: Portal, Hệ thống quản lý đào tạo, LMS...
# - location: Phòng học, Cơ sở, Ký túc xá, Thư viện...
# - event: Lễ khai giảng, Hội thảo, Hoạt động sinh viên...
# - document: Văn bản, Thông báo, Quyết định...
# - other: Các thực thể khác không thuộc các loại trên

# ============================================
# Advanced Configuration
# ============================================
# ============================================
# Logging Configuration
# ============================================
### Logging level
LOG_LEVEL=INFO
# VERBOSE=False
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5
### Logfile location (defaults to current working directory)
LOG_DIR=LightRAG/.log

# ============================================
# External Services
# ============================================

# MinerU Configuration (for PDF parsing)
# MINERU_API_URL=http://localhost:6969

# Reranker Configuration (optional, for better retrieval)
# RERANK_BINDING=cohere
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANKER_API_BASE=http://localhost:11434
# RERANKER_ENABLED=true
