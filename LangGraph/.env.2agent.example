# ============================================================================
# LLM Configuration (OpenAI-compatible API)
# ============================================================================

# API credentials
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Model selection
LLM_MODEL=gpt-4o-mini

# ============================================================================
# LightRAG API Configuration
# ============================================================================

LIGHTRAG_URL=http://localhost:8020
LIGHTRAG_API_KEY=your_lightrag_api_key
LIGHTRAG_ACCESS_TOKEN=

# ============================================================================
# Agent 1: Query Understanding Configuration
# ============================================================================

# Confidence threshold for deciding whether to ask clarification
# Below this value → ask user for clarification
# Range: 0.0 - 1.0
# Default: 0.5
# - Higher (0.6-0.7): More cautious, ask more questions
# - Lower (0.3-0.4): More aggressive, ask fewer questions
QUERY_CONFIDENCE_THRESHOLD=0.5

# Temperature for Agent 1 LLM calls
# Lower = more consistent/deterministic
# Range: 0.0 - 2.0
# Default: 0.1
AGENT1_TEMPERATURE=0.1

# ============================================================================
# Agent 2: Data Quality & Response Generation Configuration
# ============================================================================

# Data quality threshold - HIGH
# Above this value → generate full answer
# Range: 0.0 - 1.0
# Default: 0.7
DATA_QUALITY_THRESHOLD_HIGH=0.7

# Data quality threshold - LOW
# Below this value → fallback to "contact advisor"
# Range: 0.0 - 1.0
# Default: 0.4
DATA_QUALITY_THRESHOLD_LOW=0.4

# Temperature for Agent 2 assessment
# Lower = more consistent evaluation
# Range: 0.0 - 2.0
# Default: 0.1
AGENT2_ASSESSMENT_TEMP=0.1

# Temperature for Agent 2 response generation
# Higher = more creative responses
# Range: 0.0 - 2.0
# Default: 0.3
AGENT2_GENERATION_TEMP=0.3

# ============================================================================
# Retrieval Configuration
# ============================================================================

# Default retrieval mode for LightRAG
# Options: naive, local, global, hybrid, mix
# Default: mix (recommended)
DEFAULT_RETRIEVAL_MODE=mix

# Default top-k for retrieval
# Higher = more context but slower
# Default: 60
DEFAULT_TOP_K=60

# Default chunk top-k
# Default: 10
DEFAULT_CHUNK_TOP_K=10

# ============================================================================
# MinerU Configuration (for PDF parsing)
# ============================================================================

MINERU_URL=http://localhost:8765
MINERU_DIR=/tmp/mineru_output

# ============================================================================
# Logging & Debugging
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable detailed confidence logging
ENABLE_CONFIDENCE_LOGGING=true
